{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_plan_mode.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bash tools/ci/install_godot.sh)",
      "Bash(.tools/godot --headless *)",
      "Bash(godot --headless *)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)"
    ]
  }
}
